<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>Ryujinx.Android</RootNamespace>
    <ApplicationId>com.ryujinx.android</ApplicationId>
    <ApplicationTitle>Ryujinx Android</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
    <AndroidMinSdkVersion>26</AndroidMinSdkVersion>
    <RuntimeIdentifiers>android-arm64</RuntimeIdentifiers>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Ryujinx.HLE/Ryujinx.HLE.csproj" />
    <ProjectReference Include="../Ryujinx.Graphics.Vulkan/Ryujinx.Graphics.Vulkan.csproj" />
    <PackageReference Include="SkiaSharp.NativeAssets.Android" />
  </ItemGroup>
  <ItemGroup>
    <AndroidNativeLibrary Include="native/arm64-v8a/libryujinx_android.so" Abi="arm64-v8a" />
    <AndroidNativeLibrary Include="native/arm64-v8a/libshaderc_shared.so" Abi="arm64-v8a" />
  </ItemGroup>
</Project>
